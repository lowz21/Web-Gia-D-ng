# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=production

# Database Configuration (Production)
# For Render, Supabase, Neon, or other PostgreSQL providers
DATABASE_URL=postgresql://user:password@host:port/database

# Deployment Platform Detection
# Set to "true" on Render, leave empty for Vercel
RENDER=
# Set to "true" on Vercel, leave empty for Render
VERCEL=

# Cron Job Security (Vercel)
CRON_SECRET_KEY=your_cron_secret_key_here

# Cloudinary Configuration (Optional - for cloud image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage Configuration (Optional - alternative to Cloudinary)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=uploads

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

